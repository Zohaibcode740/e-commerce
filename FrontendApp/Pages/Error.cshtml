@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="text-center">

                <div class="mb-4">
                    <span class="display-1 fw-bold text-danger">500</span>
                </div>

                <h1 class="h2 fw-bold mb-3">
                    Something went wrong
                </h1>

                <p class="text-muted mb-4">
                    We couldn't process your request right now.
                    Please try again in a moment.
                </p>

                @if (Model.ShowRequestId)
                {
                    <div class="alert alert-light border mb-4">
                        <div class="small text-muted mb-1">
                            Request ID
                        </div>
                        <code class="text-dark">@Model.RequestId</code>
                    </div>
                }

                <div class="d-flex justify-content-center gap-2">
                    <a href="/" class="btn btn-primary px-4">
                        Go to Home
                    </a>

                    <button type="button"
                            class="btn btn-outline-secondary px-4"
                            onclick="window.location.reload();">
                        Try Again
                    </button>
                </div>

                @if (Environment.GetEnvironmentVariable("ASPNETCORE_ENVIRONMENT") == "Development")
                {
                    <div class="mt-5 text-start">
                        <div class="alert alert-warning">
                            <h5 class="alert-heading">
                                Development Mode
                            </h5>

                            <p class="mb-2">
                                Detailed exception information is available because
                                the application is running in the
                                <strong>Development</strong> environment.
                            </p>

                            <hr />

                            <p class="mb-0 small">
                                Never enable Development Mode in a production
                                environment, as it may expose sensitive application
                                information.
                            </p>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>
